+/* =========================================================================
+   Study Timer — the focus workspace (ported from PREPTRACK)
+
+   The palette is entirely app-native: every surface, text colour and glow
+   below derives from the design tokens at the top of this file, so the timer
+   follows the light/dark theme automatically. Each atmosphere contributes only
+   an identity tint plus its particle motion:
+
+     woodland  evergreen leaves falling through the stage
+     rain      sky-blue rainfall with a ground mist
+     night     the app's dark surfaces, a starfield and the odd meteor
+
+   Motion rules for this file follow the rest of the stylesheet:
+   - feedback transitions stay at or under 150 ms;
+   - every `animation` is declared inside
+     `@media (prefers-reduced-motion: no-preference)`, and switched off under
+     `prefers-reduced-motion: reduce`;
+   - no literal colours, no inline layout: heights and tones are classes.
+   ========================================================================= */
+
+/* --------------------------------------------------------------------------
+   0. Night tokens
+
+   The Night atmosphere is the app's dark surface set, scoped to the timer
+   workspace. Its literals live here, in a token block, for the same reason the
+   theme tokens do: component rules may only ever reference tokens, so a colour
+   cannot drift into a rule by accident. These are the only literals in this
+   file.
+   -------------------------------------------------------------------------- */
+
+:root {
+  --focus-night-bg: #0b1020;
+  --focus-night-surface: #121a33;
+  --focus-night-sunken: #0e142a;
+  --focus-night-hover: #1f2a4d;
+  --focus-night-line: #47588a;
+  --focus-night-line-strong: #6b7db3;
+  --focus-night-line-subtle: #263256;
+  --focus-night-text: #e8ecf8;
+  --focus-night-text-muted: #c3cbe4;
+  --focus-night-text-soft: #aab4d4;
+  --focus-night-accent: #6d8cff;
+  --focus-night-accent-strong: #a8bbff;
+  --focus-night-accent-soft: #1c2a52;
+  --focus-night-ok: #34d399;
+  --focus-night-ok-soft: #14332c;
+  --focus-night-warn: #fbbf24;
+  --focus-night-warn-soft: #3a3020;
+  --focus-night-bad: #f87171;
+  --focus-night-bad-soft: #3b2430;
+  --focus-night-info: #38bdf8;
+  --focus-night-info-soft: #14293d;
+  --focus-night-top: #18213f;
+  --focus-night-glow-accent: #1c2a52;
+  --focus-night-glow-info: #14293d;
+  --focus-night-veil: #0e1530;
+  --focus-night-sheen: rgba(255, 255, 255, 0.1);
+  --focus-night-shadow: 0 10px 25px -5px rgba(3, 8, 28, 0.55);
+  --focus-night-stage-shadow: 0 10px 30px rgba(3, 8, 28, 0.45);
+  --focus-night-stage-top: #16203c;
+  /* Mask stop: an opaque stop is any fully opaque colour; using the theme's
+     text token keeps the literal count in this file to one block. */
+  --focus-mask-opaque: #000000;
+}
+
+/* --------------------------------------------------------------------------
+   1. The workspace: a stage that owns its own tints
+   -------------------------------------------------------------------------- */
+
+.focus-workspace {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  margin-bottom: var(--gap-grid);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg);
+  background: var(--bg-elevated);
+  color: var(--text);
+  /* Default (woodland) identity: the app's own evergreen. */
+  --focus-accent: var(--ok);
+  --focus-glow: radial-gradient(circle 520px at 24% 32%, var(--ok-soft), transparent 72%),
+    radial-gradient(circle 460px at 78% 36%, var(--accent-soft), transparent 72%);
+  --focus-veil: linear-gradient(180deg, var(--ok-soft), transparent 60%);
+  --fc-bg-top: var(--bg-elevated);
+  --fc-bg-bottom: var(--bg-sunken);
+  --fc-text: var(--text);
+  --fc-split: var(--border-strong);
+  --fc-border: var(--border-strong);
+  --fc-shadow: var(--shadow);
+  --fc-sheen: transparent;
+  --leaf-a: var(--ok);
+  --leaf-b: var(--accent);
+  --leaf-c: var(--info);
+  --rain-colour: var(--info);
+}
+
+.focus-workspace.environment-woodland {
+  background: linear-gradient(180deg, var(--ok-soft), var(--bg-elevated) 42%);
+}
+
+.focus-workspace.environment-rain {
+  --focus-accent: var(--info);
+  --focus-glow: radial-gradient(circle 520px at 50% 8%, var(--info-soft), transparent 72%),
+    radial-gradient(circle 420px at 34% 14%, var(--info-soft), transparent 72%);
+  --focus-veil: linear-gradient(180deg, var(--info-soft), transparent 58%);
+  background: linear-gradient(180deg, var(--info-soft), var(--bg-elevated) 44%);
+}
+
+/*
+ * Night is the app's dark surface set, scoped to this workspace only. The shell
+ * keeps the reader's own theme; every timer surface inside the stage goes dark,
+ * including the flip cards, which is what makes the stage read as a room with
+ * the lights off rather than a light card with blue text.
+ */
+.focus-workspace.environment-night {
+  --bg: var(--focus-night-bg);
+  --bg-elevated: var(--focus-night-surface);
+  --bg-sunken: var(--focus-night-sunken);
+  --surface-hover: var(--focus-night-hover);
+  --border: var(--focus-night-line);
+  --border-strong: var(--focus-night-line-strong);
+  --border-subtle: var(--focus-night-line-subtle);
+  --text: var(--focus-night-text);
+  --text-muted: var(--focus-night-text-muted);
+  --text-soft: var(--focus-night-text-soft);
+  --accent: var(--focus-night-accent);
+  --accent-strong: var(--focus-night-accent-strong);
+  --accent-soft: var(--focus-night-accent-soft);
+  --ok: var(--focus-night-ok);
+  --ok-soft: var(--focus-night-ok-soft);
+  --warn: var(--focus-night-warn);
+  --warn-soft: var(--focus-night-warn-soft);
+  --bad: var(--focus-night-bad);
+  --bad-soft: var(--focus-night-bad-soft);
+  --info: var(--focus-night-info);
+  --info-soft: var(--focus-night-info-soft);
+  --shadow: var(--focus-night-stage-shadow);
+  --track: var(--focus-night-line-subtle);
+  --focus-accent: var(--accent);
+  --focus-glow: radial-gradient(circle 540px at 50% 15%, var(--focus-night-glow-accent), transparent 72%),
+    radial-gradient(circle 430px at 34% 20%, var(--focus-night-glow-info), transparent 72%);
+  --focus-veil: linear-gradient(180deg, var(--focus-night-veil), transparent 62%);
+  --fc-bg-top: var(--focus-night-top);
+  --fc-bg-bottom: var(--focus-night-surface);
+  --fc-text: var(--text);
+  --fc-split: var(--focus-night-line);
+  --fc-border: var(--focus-night-line-strong);
+  --fc-shadow: var(--focus-night-shadow);
+  --fc-sheen: var(--focus-night-sheen);
+  --leaf-a: var(--focus-night-ok);
+  --leaf-b: var(--focus-night-ok);
+  --leaf-c: var(--focus-night-info);
+  --rain-colour: var(--focus-night-info);
+  background: linear-gradient(180deg, var(--focus-night-stage-top), var(--bg) 46%, var(--bg));
+}
+
+/* The stage card sits on the tint, not over it. */
+.focus-workspace .card {
+  border-color: var(--border-subtle);
+  background: var(--bg-elevated);
+}
+
+.focus-workspace.environment-night .card {
+  border-color: var(--border-subtle);
+  color: var(--text);
+}
+
+.focus-workspace .card-head h2 {
+  color: var(--text);
+}
+
+/* --------------------------------------------------------------------------
+   2. The atmosphere layer: glow, rain, leaves, night sky
+   -------------------------------------------------------------------------- */
+
+.focus-atmosphere-layer {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  overflow: hidden;
+}
+
+.focus-glow {
+  position: absolute;
+  inset: 0;
+  opacity: 0.85;
+  /* Feather the wash vertically so no paint touches the stage's clip edge. */
+  -webkit-mask-image: linear-gradient(180deg, transparent 0%, var(--focus-mask-opaque) 14%, var(--focus-mask-opaque) 55%, transparent 92%);
+  mask-image: linear-gradient(180deg, transparent 0%, var(--focus-mask-opaque) 14%, var(--focus-mask-opaque) 55%, transparent 92%);
+}
+
+.focus-glow-inner {
+  position: absolute;
+  inset: 0;
+  background: var(--focus-glow);
+  -webkit-mask-image: linear-gradient(90deg, transparent 0%, var(--focus-mask-opaque) 16%, var(--focus-mask-opaque) 84%, transparent 100%);
+  mask-image: linear-gradient(90deg, transparent 0%, var(--focus-mask-opaque) 16%, var(--focus-mask-opaque) 84%, transparent 100%);
+}
+
+.rain-veil,
+.leaf-veil,
+.night-sky {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+}
+
+/* Rain: two parallax layers of drops plus a mist drift along the ground. */
+.rain-drop {
+  position: absolute;
+  top: -12%;
+  width: 3px;
+  border-radius: var(--radius-pill);
+  background: linear-gradient(to bottom, transparent, var(--rain-colour));
+  will-change: transform;
+}
+
+.rain-drop.layer-far {
+  width: 2px;
+  filter: blur(0.6px);
+}
+
+.rain-mist {
+  position: absolute;
+  inset: auto -8% -6%;
+  height: 34vh;
+}
+
+.mist-band {
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(ellipse 55% 90% at 20% 100%, var(--info-soft), transparent 70%),
+    radial-gradient(ellipse 60% 100% at 75% 100%, var(--accent-soft), transparent 72%);
+  filter: blur(12px);
+  opacity: 0.8;
+}
+
+.mist-band.b {
+  opacity: 0.55;
+}
+
+/* Woodland: leaves on three depth layers — far ones small, dim and slow. */
+.particle-leaf {
+  position: absolute;
+  top: -6vh;
+  border-radius: 60% 40% 55% 45%;
+  background: var(--leaf-a);
+  opacity: var(--op, 0.3);
+  will-change: transform;
+}
+
+.particle-leaf.tone-b {
+  background: var(--leaf-b);
+}
+
+.particle-leaf.tone-c {
+  background: var(--leaf-c);
+}
+
+.particle-leaf.depth-0 {
+  filter: blur(0.8px);
+}
+
+/* Night: quiet twinkling stars, and meteors drawn by the view on demand. */
+.star-dot {
+  position: absolute;
+  border-radius: 50%;
+  background: var(--text);
+  opacity: var(--tw-op, 0.3);
+}
+
+.shooting-star {
+  position: absolute;
+  height: 2px;
+  width: var(--star-width, 120px);
+  border-radius: var(--radius-pill);
+  opacity: 0;
+  background: linear-gradient(
+    to right,
+    transparent,
+    color-mix(in srgb, var(--text) 45%, transparent) 55%,
+    var(--text) 100%
+  );
+  box-shadow: 0 0 var(--star-glow, 6px) var(--text);
+}
+
+/* --------------------------------------------------------------------------
+   3. The stage: mode switch, phase, clock, task, controls
+   -------------------------------------------------------------------------- */
+
+.focus-stage .card-body {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-6) var(--space-5) var(--space-5);
+  background: linear-gradient(160deg, var(--fc-bg-top), var(--fc-bg-bottom));
+}
+
+.focus-stage-top {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: var(--space-3);
+  width: 100%;
+}
+
+.focus-mode {
+  justify-self: start;
+}
+
+.focus-phase {
+  justify-self: center;
+  color: var(--focus-accent);
+  font-size: var(--text-2xs);
+  font-weight: 800;
+  letter-spacing: 0.16em;
+}
+
+.focus-sound-state {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  justify-self: end;
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+}
+
+.focus-clock-holder {
+  display: flex;
+  justify-content: center;
+  width: 100%;
+  margin-top: var(--space-4);
+}
+
+/* --- the flip clock ------------------------------------------------------ */
+
+.flip-clock {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  font-family: var(--mono);
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  user-select: none;
+}
+
+.flip-group {
+  display: flex;
+  gap: 4px;
+}
+
+.flip-colon {
+  color: var(--fc-text);
+  font-size: clamp(28px, 4.4vw, 44px);
+  line-height: 1;
+  opacity: 0.8;
+  padding-bottom: 0.12em;
+}
+
+.flip-digit {
+  position: relative;
+  width: clamp(52px, 8.4vw, 88px);
+  height: clamp(78px, 12.6vw, 132px);
+  border-radius: var(--radius-sm);
+  background: var(--fc-bg-bottom);
+  color: var(--fc-text);
+  font-size: clamp(52px, 8.4vw, 88px);
+  text-align: center;
+  perspective: 1200px;
+  box-shadow: inset 0 0 0 1px var(--fc-border), var(--fc-shadow);
+}
+
+.flip-half {
+  position: absolute;
+  left: 0;
+  right: 0;
+  height: 50%;
+  overflow: hidden;
+  border-radius: var(--radius-sm);
+  color: var(--fc-text);
+  backface-visibility: hidden;
+  transform-style: preserve-3d;
+}
+
+.flip-half.top {
+  top: 0;
+  transform-origin: bottom;
+  border-bottom-left-radius: 0;
+  border-bottom-right-radius: 0;
+  border-bottom: 1px solid var(--fc-split);
+  background: var(--fc-bg-top);
+}
+
+.flip-half.bottom {
+  bottom: 0;
+  transform-origin: top;
+  border-top-left-radius: 0;
+  border-top-right-radius: 0;
+  background: var(--fc-bg-bottom);
+}
+
+.flip-half .val {
+  position: absolute;
+  left: 0;
+  width: 100%;
+  height: clamp(78px, 12.6vw, 132px);
+  line-height: clamp(78px, 12.6vw, 132px);
+}
+
+.flip-half.top .val {
+  top: 0;
+}
+
+.flip-half.bottom .val {
+  bottom: 0;
+}
+
+.flip-flap {
+  z-index: 2;
+}
+
+/* --- caption and progress ------------------------------------------------ */
+
+.focus-caption {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: var(--text-xs);
+  text-align: center;
+}
+
+.focus-progress {
+  width: min(440px, 74%);
+  height: 3px;
+  margin: 0;
+  overflow: hidden;
+  border-radius: var(--radius-pill);
+  background: var(--track);
+}
+
+.focus-progress > span {
+  display: block;
+  width: 0;
+  height: 100%;
+  background: linear-gradient(90deg, var(--accent), var(--focus-accent));
+}
+
+/* Widths are classes (steps of 5%) so the stylesheet stays the only place
+   that decides layout; see `data-pct` below for the exact value. */
+.focus-progress > span[data-pct="0"] { width: 0; }
+.focus-progress > span[data-pct="5"] { width: 5%; }
+.focus-progress > span[data-pct="10"] { width: 10%; }
+.focus-progress > span[data-pct="15"] { width: 15%; }
+.focus-progress > span[data-pct="20"] { width: 20%; }
