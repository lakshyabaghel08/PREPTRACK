diff --git a/js/ui/flipclock.js b/js/ui/flipclock.js
new file mode 100644
index 0000000..e92fbac
--- /dev/null
+++ b/js/ui/flipclock.js
@@ -0,0 +1,203 @@
+/**
+ * flipclock.js — the split-flap clock at the centre of the Study Timer.
+ *
+ * Two digits per unit, each a pair of static halves (`.flip-half.top` and
+ * `.flip-half.bottom`) holding the current value, plus two transient
+ * `.flip-flap` halves that perform the physical flip when the value changes.
+ * The animation itself lives in css/app.css (`flipTop`/`flipBottom`, 300 ms +
+ * 300 ms staged rotateX); this module only builds the DOM and decides *when*
+ * to animate.
+ *
+ * It is deliberate about three things:
+ *
+ *  - **Only changed digits flip.** Ticking 00:59 → 01:00 must flip three
+ *    digits, not six, and a paused clock must never flip at all.
+ *  - **Structure changes snap.** Going 59:59 → 1:00:00 adds an hours group;
+ *    repainting instantly there is the difference between a clock and a glitch.
+ *  - **It is a live widget, not a re-rendered string.** The router repaints a
+ *    screen on every refresh; a clock that was rebuilt from scratch would lose
+ *    the value it compares against and stop animating mid-session. So the
+ *    element is built once, `setTime()` is called every tick, and mounting a
+ *    fresh tree simply resets the comparison.
+ */
+
+const DIGITS = ['h1', 'h0', 'm1', 'm0', 's1', 's0'];
+/** Total flip time: 300 ms top flap + 300 ms bottom flap (see css/app.css). */
+const FLAP_MS = 600;
+
+/** Split a duration into the two-digit groups the clock shows. */
+function clockParts(totalSeconds) {
+  const total = Math.max(0, Math.round(Number(totalSeconds) || 0));
+  const hours = Math.floor(total / 3600);
+  const minutes = Math.floor((total % 3600) / 60);
+  const seconds = total % 60;
+  const pad = (value) => String(value).padStart(2, '0');
+  return {
+    showHours: hours > 0,
+    digits: hours > 0 ? `${pad(hours)}${pad(minutes)}${pad(seconds)}` : `${pad(minutes)}${pad(seconds)}`,
+    text: hours > 0 ? `${hours}:${pad(minutes)}:${pad(seconds)}` : `${pad(minutes)}:${pad(seconds)}`,
+  };
+}
+
+/**
+ * Everything that moves for one flip. Exported so the tests can assert the
+ * *behaviour* (which digits flip, when, and in what order) without a browser
+ * layout engine.
+ */
+export class FlipClock {
+  /**
+   * @param {{ label?: string }} options  `label` describes the clock to a
+   *   screen reader; the value itself is announced by the caller, not per tick.
+   */
+  constructor({ label = 'Timer' } = {}) {
+    this.label = label;
+    this.root = null;
+    this.handles = new Map();
+    this.rendered = '';
+    this.timeout = null;
+  }
+
+  /** Build the element. Called by the view's `mount()`; safe to call once. */
+  render() {
+    const root = document.createElement('div');
+    root.className = 'flip-clock';
+    root.setAttribute('role', 'timer');
+    root.setAttribute('aria-live', 'off');
+    root.setAttribute('aria-label', this.label);
+    root.innerHTML = this.markup();
+    this.root = root;
+    DIGITS.forEach((id) => this.bind(root, id));
+    return root;
+  }
+
+  markup() {
+    // One `.flip-group` per unit, holding that unit's two digits directly. The
+    // hours group carries `data-group="hours"` and starts hidden, so the clock
+    // is a four-digit face until a block passes an hour and needs six.
+    const digits = (ids) => ids.map((id) => `
+      <div class="flip-digit" data-digit="${id}" aria-hidden="true">
+        <div class="flip-half top"><div class="val">0</div></div>
+        <div class="flip-half bottom"><div class="val">0</div></div>
+      </div>`).join('');
+    return [
+      `<div class="flip-group" data-group="hours" hidden>${digits(['h1', 'h0'])}</div>`,
+      `<span class="flip-colon" data-colon="hours" aria-hidden="true" hidden>:</span>`,
+      `<div class="flip-group" data-group="minutes">${digits(['m1', 'm0'])}</div>`,
+      `<span class="flip-colon" aria-hidden="true">:</span>`,
+      `<div class="flip-group" data-group="seconds">${digits(['s1', 's0'])}</div>`,
+    ].join('');
+  }
+
+  bind(root, id) {
+    const node = root.querySelector(`[data-digit="${id}"]`);
+    if (!node) return;
+    this.handles.set(id, {
+      root: node,
+      top: node.querySelector('.flip-half.top .val'),
+      bottom: node.querySelector('.flip-half.bottom .val'),
+      value: '',
+      timeout: null,
+    });
+  }
+
+  /**
+   * Show `totalSeconds`. `animate` is false while paused and on the first
+   * paint, so a resumed session does not flip every digit at once.
+   */
+  setTime(totalSeconds, animate = false) {
+    if (!this.root) return;
+    const { digits, showHours } = clockParts(totalSeconds);
+
+    // Hours appear/disappear: repaint the whole clock without animating.
+    const hoursGroup = this.root.querySelector('[data-group="hours"]');
+    const hoursColon = this.root.querySelector('[data-colon="hours"]');
+    if (hoursGroup) hoursGroup.hidden = !showHours;
+    if (hoursColon) hoursColon.hidden = !showHours;
+    this.root.classList.toggle('with-hours', showHours);
+
+    const structural = this.rendered.length !== digits.length;
+    const ids = showHours ? DIGITS : DIGITS.slice(2);
+    ids.forEach((id, index) => {
+      const next = digits[index] ?? '0';
+      const handle = this.handles.get(id);
+      if (!handle) return;
+      if (structural || !animate || handle.value === '' || handle.value === next) {
+        this.snap(handle, next);
+      } else {
+        this.flip(handle, next);
+      }
+    });
+    this.rendered = digits;
+    this.root.setAttribute('aria-label', `${this.label}: ${clockParts(totalSeconds).text}`);
+  }
+
+  /** Set a digit with no motion. */
+  snap(handle, value) {
+    if (handle.timeout) {
+      clearTimeout(handle.timeout);
+      handle.timeout = null;
+    }
+    handle.root.querySelectorAll('.flip-flap').forEach((node) => node.remove());
+    handle.top.textContent = value;
+    handle.bottom.textContent = value;
+    handle.value = value;
+  }
+
+  /**
+   * The physical flip: the outgoing value rides the falling top flap while the
+   * incoming value rises on the bottom flap; the static halves underneath
+   * already hold the target, so the seam is never empty.
+   */
+  flip(handle, value) {
+    const previous = handle.value;
+    handle.value = value;
+    if (handle.timeout) {
+      clearTimeout(handle.timeout);
+      handle.timeout = null;
+    }
+    handle.root.querySelectorAll('.flip-flap').forEach((node) => node.remove());
+
+    handle.top.textContent = value;
+    handle.bottom.textContent = previous;
+
+    const topFlap = document.createElement('div');
+    topFlap.className = 'flip-half top flip-flap';
+    topFlap.innerHTML = `<div class="val">${previous}</div>`;
+    const bottomFlap = document.createElement('div');
+    bottomFlap.className = 'flip-half bottom flip-flap';
+    bottomFlap.innerHTML = `<div class="val">${value}</div>`;
+    handle.root.appendChild(topFlap);
+    handle.root.appendChild(bottomFlap);
+
+    handle.timeout = setTimeout(() => {
+      handle.bottom.textContent = value;
+      topFlap.remove();
+      bottomFlap.remove();
+      handle.timeout = null;
+    }, FLAP_MS);
+  }
+
+  /** Drop every pending flap timer (the screen is being torn down). */
+  destroy() {
+    for (const handle of this.handles.values()) {
+      if (handle.timeout) clearTimeout(handle.timeout);
+    }
+    this.handles.clear();
+    this.root = null;
+  }
+}
+
+/**
+ * Plain markup for the static placeholder a screen paints before its `mount()`
+ * runs. It is the same four-digit face the live clock starts with, so the stage
+ * does not change size when the real clock replaces it.
+ */
+export function flipClockSkeleton() {
+  const digits = () =>
+    '<div class="flip-digit"><div class="flip-half top"><div class="val">0</div></div><div class="flip-half bottom"><div class="val">0</div></div></div>'.repeat(2);
+  return `<div class="flip-clock is-placeholder" aria-hidden="true">
+    <div class="flip-group">${digits()}</div>
+    <span class="flip-colon">:</span>
+    <div class="flip-group">${digits()}</div>
+  </div>`;
+}
diff --git a/js/ui/focus-atmosphere.js b/js/ui/focus-atmosphere.js
new file mode 100644
index 0000000..0d33b14
--- /dev/null
+++ b/js/ui/focus-atmosphere.js
@@ -0,0 +1,247 @@
+/**
+ * focus-atmosphere.js — the Study Timer's visual layer.
+ *
+ * Each atmosphere is a tint (in css/focus-timer.css, derived from the app's own
+ * design tokens so both themes follow) plus one signature motion:
+ *
+ *   woodland  drifting leaves in three token tones, on three depth layers —
+ *             far ones smaller, dimmer and slower, with a sway mid-fall
+ *   rain      two parallax drop layers (thin far drops, heavier near ones) and
+ *             a slow mist drift along the ground
+ *   night     a quiet twinkling starfield with the occasional shooting star —
+ *             a lone streak or a short meteor shower
+ *
+ * Everything is generated once per mount from a seeded PRNG, so a re-render does
+ * not reshuffle the sky. The particles are animated by CSS keyframes rather than
+ * by a timer: the browser composites them, and they stop dead when the reader
+ * prefers reduced motion (the stylesheet switches the animations off).
+ *
+ * Each particle needs its own numbers (where it starts, how long it takes), and
+ * those cannot go in the markup: this app keeps every visual rule in the
+ * stylesheet and forbids inline `style` attributes (tools/check.mjs). So the
+ * numbers are handed to the CSSOM after the element is parsed —
+ * `el.style.setProperty(...)` produces a real style rule, not an attribute in
+ * the source — which keeps the source free of presentational markup while still
+ * letting fifty raindrops fall at fifty different speeds.
+ *
+ * Nothing here touches layout: the layer is absolutely positioned inside the
+ * workspace, `aria-hidden`, and click-through.
+ */
+
+/** Mulberry32 — small, fast, and reproducible so the sky is stable. */
+function seeded(seed) {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function makeLeaves(count = 22, seed = 7717) {
+  const rand = seeded(seed);
+  return Array.from({ length: count }, () => {
+    const depth = Math.floor(rand() * 3); // 0 far → 2 near
+    const scale = depth === 0 ? 0.7 : depth === 2 ? 1.15 : 1;
+    return {
+      left: rand() * 100,
+      size: (4 + rand() * 3) * scale,
+      duration: (1.9 + rand() * 1.9) * (depth === 0 ? 1.3 : depth === 2 ? 0.85 : 1),
+      delay: -rand() * 4,
+      opacity: (0.2 + rand() * 0.24) * (depth === 0 ? 0.65 : 1),
+      drift: (rand() - 0.5) * 120,
+      rotation: 360 + rand() * 720,
+      sway: 8 + rand() * 14,
+      tone: Math.floor(rand() * 3),
+      depth,
+    };
+  });
+}
+
+export function makeRaindrops(seed = 20260521) {
+  const rand = seeded(seed);
+  const drop = (far) => ({
+    left: rand() * 100,
+    height: far ? 16 + rand() * 14 : 30 + rand() * 30,
+    duration: far ? 2.8 + rand() * 1.8 : 1.9 + rand() * 1.2,
+    delay: -rand() * 4,
+    opacity: far ? 0.12 + rand() * 0.1 : 0.2 + rand() * 0.22,
+    far,
+  });
+  return [...Array.from({ length: 55 }, () => drop(true)), ...Array.from({ length: 35 }, () => drop(false))];
+}
+
+export function makeStarfield(count = 46, seed = 5150) {
+  const rand = seeded(seed);
+  return Array.from({ length: count }, () => ({
+    left: rand() * 100,
+    top: rand() * 68,
+    size: 1 + rand() * 1.4,
+    opacity: 0.12 + rand() * 0.38,
+    twinkle: 3 + rand() * 4,
+    delay: -rand() * 6,
+  }));
+}
+
+/**
+ * One shooting star. Three profiles — a faint lone streak, a brighter one, and
+ * a rare long meteor — chosen at random, because a sky with only one kind of
+ * streak reads as a screensaver.
+ */
+export function makeStar(rand = Math.random) {
+  const roll = rand();
+  const profile =
+    roll < 0.65
+      ? { width: 30 + rand() * 40, duration: 0.5 + rand() * 0.4, glow: 1 + rand() * 2, opacity: 0.12 + rand() * 0.14, color: '255, 255, 255' }
+      : roll < 0.95
+        ? { width: 80 + rand() * 60, duration: 0.9 + rand() * 0.6, glow: 4 + rand() * 4, opacity: 0.3 + rand() * 0.22, color: '220, 230, 255' }
+        : { width: 170 + rand() * 140, duration: 1.6 + rand() * 1.3, glow: 14 + rand() * 10, opacity: 0.62 + rand() * 0.18, color: '255, 230, 200' };
+  const angle = 10 + rand() * 35;
+  const distance = 760 + rand() * 380;
+  return {
+    left: rand() * 90 - 10,
+    top: rand() * 55 - 10,
+    angle,
+    travelX: distance * Math.cos((angle * Math.PI) / 180),
+    travelY: distance * Math.sin((angle * Math.PI) / 180),
+    delayMs: 0,
+    ...profile,
+  };
+}
+
+/**
+ * Apply a particle's numbers to its element. Values may be plain CSS numbers
+ * (`left`, `opacity`) or custom properties (`--dur`), which is how the
+ * keyframes read them.
+ */
+function applyVars(node, vars) {
+  for (const [name, value] of vars) {
+    node.style.setProperty(name, String(value));
+  }
+}
+
+function span(className, vars) {
+  const node = document.createElement('span');
+  node.className = className;
+  applyVars(node, vars);
+  return node;
+}
+
+/**
+ * Build the atmosphere element for `environment`. Meteors are not spawned here
+ * — the view shows them when it wants to (see `spawnMeteors()`), so a paused
+ * screen has none.
+ */
+export function renderAtmosphere(environment = 'woodland') {
+  const layer = document.createElement('div');
+  layer.className = 'focus-atmosphere-layer';
+  layer.dataset.environment = environment;
+  layer.setAttribute('aria-hidden', 'true');
+
+  const glow = document.createElement('div');
+  glow.className = 'focus-glow';
+  glow.innerHTML = '<div class="focus-glow-inner"></div>';
+  layer.appendChild(glow);
+
+  if (environment === 'rain') {
+    const veil = document.createElement('div');
+    veil.className = 'rain-veil';
+    for (const drop of makeRaindrops()) {
+      veil.appendChild(
+        span(`rain-drop${drop.far ? ' layer-far' : ''}`, [
+          ['left', `${drop.left}%`],
+          ['height', `${drop.height}px`],
+          ['--dur', `${drop.duration}s`],
+          ['--delay', `${drop.delay}s`],
+          ['opacity', drop.opacity],
+        ]),
+      );
+    }
+    const mist = document.createElement('div');
+    mist.className = 'rain-mist';
+    mist.innerHTML = '<span class="mist-band"></span><span class="mist-band b"></span>';
+    veil.appendChild(mist);
+    layer.appendChild(veil);
+  }
+
+  if (environment === 'woodland') {
+    const veil = document.createElement('div');
+    veil.className = 'leaf-veil';
+    for (const leaf of makeLeaves()) {
+      veil.appendChild(
+        span(`particle-leaf tone-${'abc'[leaf.tone]} depth-${leaf.depth}`, [
+          ['--sx', `${leaf.left}vw`],
+          ['--ex', `${leaf.drift}vw`],
+          ['--sway', `${leaf.sway}px`],
+          ['--dur', `${leaf.duration * 11}s`],
+          ['--op', String(leaf.opacity)],
+          ['--rot', `${leaf.rotation}deg`],
+          ['width', `${leaf.size}px`],
+          ['height', `${leaf.size}px`],
+          ['--delay', `${-leaf.duration * 9}s`],
+        ]),
+      );
+    }
+    layer.appendChild(veil);
+  }
+
+  if (environment === 'night') {
+    const sky = document.createElement('div');
+    sky.className = 'night-sky';
+    for (const dot of makeStarfield()) {
+      sky.appendChild(
+        span('star-dot', [
+          ['left', `${dot.left}%`],
+          ['top', `${dot.top}%`],
+          ['width', `${dot.size}px`],
+          ['height', `${dot.size}px`],
+          ['--tw-op', String(dot.opacity)],
+          ['--tw-dur', `${dot.twinkle}s`],
+          ['--tw-delay', `${dot.delay}s`],
+        ]),
+      );
+    }
+    layer.appendChild(sky);
+  }
+
+  return layer;
+}
+
+/**
+ * Show `count` meteors in a night sky, staggered slightly so a shower reads as
+ * a shower. Returns a teardown that removes them.
+ */
+export function spawnMeteors(sky, count = 1, rand = Math.random) {
+  if (!sky) return () => {};
+  const nodes = [];
+  let longest = 0;
+  for (let index = 0; index < count; index += 1) {
+    const star = makeStar(rand);
+    if (index > 0) {
+      star.left = Math.min(92, star.left + index * (4 + rand() * 6));
+      star.top = Math.min(48, star.top + index * (1 + rand() * 3));
+      star.delayMs = index * (90 + rand() * 220);
+    }
+    longest = Math.max(longest, star.delayMs + star.duration * 1000);
+    const node = span('shooting-star', [
+      ['left', `${star.left}%`],
+      ['top', `${star.top}%`],
+      ['animation-delay', `${star.delayMs}ms`],
+      ['--star-width', `${star.width}px`],
+      ['--star-duration', `${star.duration}s`],
+      ['--star-glow', `${star.glow}px`],
+      ['--star-opacity', String(star.opacity)],
+      ['--star-angle', `${star.angle}deg`],
+      ['--star-travel-x', `${star.travelX}px`],
+      ['--star-travel-y', `${star.travelY}px`],
+    ]);
+    sky.appendChild(node);
+    nodes.push(node);
+  }
+  const timer = setTimeout(() => nodes.forEach((node) => node.remove()), longest + 400);
+  return () => {
+    clearTimeout(timer);
+    nodes.forEach((node) => node.remove());
+  };
+}
diff --git a/js/ui/focus-audio.js b/js/ui/focus-audio.js
new file mode 100644
index 0000000..1977107
--- /dev/null
+++ b/js/ui/focus-audio.js
@@ -0,0 +1,227 @@
+/**
+ * focus-audio.js — the Study Timer's ambient soundscapes and bells, synthesised
+ * with the Web Audio API.
+ *
+ * The reference implementation shipped three looped MP3s (38 MB in total) plus
+ * two bell files. That is a third of this app's whole download for a feature
+ * most readers use with the sound off, and it has to be precached for offline
+ * use to keep working. Noise and bells do not need to be recorded: an
+ * AudioBufferSourceNode of shaped noise plus a couple of decaying sine partials
+ * produces a woodland, a rainstorm and a night fire that loop forever, cost
+ * nothing to download, and never need the network.
+ *
+ * Design rules:
+ *  - Nothing is created until the reader asks for sound (`unlock()` runs inside
+ *    the click that enables it, which is what browsers require), and everything
+ *    is torn down when they turn it off.
+ *  - Every public call is a no-op when Web Audio is unavailable (jsdom, older
+ *    browsers), so the rest of the app cannot fail because sound did not start.
+ *  - Volume is applied from the reader's percentage, capped well below unity so
+ *    a first "enable sound" press cannot be startling.
+ */
+
+const MIN_GAIN = 0;
+const MAX_GAIN = 0.55;
+
+let context = null;
+/** The live soundscape: { gain, stop } for the nodes currently running. */
+let ambient = null;
+let currentScape = null;
+let currentVolume = 45;
+
+function AudioContextClass() {
+  if (typeof window === 'undefined') return null;
+  return window.AudioContext || window.webkitAudioContext || null;
+}
+
+export const isAudioSupported = () => Boolean(AudioContextClass());
+
+/** Create (or revive) the one AudioContext this app uses. */
+function ensureContext() {
+  const Ctor = AudioContextClass();
+  if (!Ctor) return null;
+  if (!context) {
+    try {
+      context = new Ctor();
+    } catch {
+      return null;
+    }
+  }
+  if (context.state === 'suspended') context.resume().catch(() => {});
+  return context;
+}
+
+/**
+ * Two seconds of noise, looped. `tint` shapes the spectrum:
+ *   'rain'     bright, hissy — high-passed noise with a slow swell
+ *   'woodland' mid-brown noise, wind through leaves
+ *   'night'    low noise, the bed under a fire/crickets
+ */
+function noiseBuffer(ctx, seconds = 2.5) {
+  const frames = Math.floor(ctx.sampleRate * seconds);
+  const buffer = ctx.createBuffer(1, frames, ctx.sampleRate);
+  const data = buffer.getChannelData(0);
+  // Brown-ish integration gives a fuller, less "hiss" texture than pure white.
+  let last = 0;
+  for (let i = 0; i < frames; i += 1) {
+    const white = Math.random() * 2 - 1;
+    last = (last + 0.02 * white) / 1.02;
+    data[i] = last * 3.2;
+  }
+  return buffer;
+}
+
+const SOUNDSCAPES = {
+  rain: { label: 'Rainfall', filter: 'highpass', frequency: 900, q: 0.6, gain: 0.9, swell: { depth: 0.22, rate: 0.06 } },
+  woodland: { label: 'Woodland wind', filter: 'lowpass', frequency: 780, q: 1.2, gain: 0.85, swell: { depth: 0.3, rate: 0.045 } },
+  night: { label: 'Night fire', filter: 'lowpass', frequency: 420, q: 2.2, gain: 0.8, swell: { depth: 0.35, rate: 0.09 } },
+};
+
+export const soundscapeLabel = (key) => SOUNDSCAPES[key]?.label || key;
+
+/** Start (or replace) the ambient bed. Safe to call repeatedly. */
+export function startAmbient(scape = 'woodland', volume = currentVolume) {
+  const ctx = ensureContext();
+  if (!ctx) return false;
+  const preset = SOUNDSCAPES[scape] || SOUNDSCAPES.woodland;
+  currentVolume = volume;
+  if (ambient && currentScape === scape) {
+    setAmbientVolume(volume);
+    return true;
+  }
+  stopAmbient();
+
+  const source = ctx.createBufferSource();
+  source.buffer = noiseBuffer(ctx);
+  source.loop = true;
+
+  const filter = ctx.createBiquadFilter();
+  filter.type = preset.filter;
+  filter.frequency.value = preset.frequency;
+  filter.Q.value = preset.q;
+
+  const gain = ctx.createGain();
+  gain.gain.value = 0;
+  source.connect(filter).connect(gain).connect(ctx.destination);
+
+  // A slow swell keeps the loop from reading as a static hiss.
+  const lfo = ctx.createOscillator();
+  const lfoGain = ctx.createGain();
+  lfo.frequency.value = preset.swell.rate;
+  lfoGain.gain.value = preset.swell.depth;
+  lfo.connect(lfoGain).connect(gain.gain);
+  lfo.start();
+
+  const target = Math.max(MIN_GAIN, Math.min(MAX_GAIN, (volume / 100) * MAX_GAIN)) * preset.gain;
+  // Fade in over 1.2 s: an abrupt wall of noise is a shock, not an atmosphere.
+  gain.gain.setValueAtTime(0, ctx.currentTime);
+  gain.gain.linearRampToValueAtTime(target, ctx.currentTime + 1.2);
+
+  source.start();
+  ambient = {
+    gain,
+    stop() {
+      try {
+        source.stop();
+        lfo.stop();
+        source.disconnect();
+        filter.disconnect();
+        gain.disconnect();
+      } catch {
+        /* already stopped */
+      }
+    },
+  };
+  currentScape = scape;
+  return true;
+}
+
+export function setAmbientVolume(volume = currentVolume) {
+  currentVolume = volume;
+  if (!ambient || !context) return;
+  const preset = SOUNDSCAPES[currentScape] || SOUNDSCAPES.woodland;
+  const target = Math.max(MIN_GAIN, Math.min(MAX_GAIN, (volume / 100) * MAX_GAIN)) * preset.gain;
+  ambient.gain.gain.cancelScheduledValues(context.currentTime);
+  ambient.gain.gain.setTargetAtTime(target, context.currentTime, 0.25);
+}
+
+export function stopAmbient() {
+  if (!ambient) return;
+  try {
+    ambient.stop();
+  } finally {
+    ambient = null;
+    currentScape = null;
+  }
+}
+
+
+/* ------------------------------------------------------------------ bells --- */
+
+/**
+ * A struck bell: a fundamental plus inharmonic partials, each decaying faster
+ * than the last. `kind` picks the pitch and length:
+ *   'time-up'     a clear, bright strike — the block is over
+ *   'mindfulness' a softer, longer, lower chime — come back to the breath
+ */
+export function playBell(kind = 'time-up', volume = currentVolume) {
+  const ctx = ensureContext();
+  if (!ctx) return false;
+  const level = Math.max(0, Math.min(1, volume / 100));
+  if (level <= 0) return false;
+
+  const soft = kind === 'mindfulness';
+  const base = soft ? 396 : 660;
+  const duration = soft ? 4.2 : 2.2;
+  const peak = level * (soft ? 0.22 : 0.3);
+  const partials = soft ? [1, 2.01, 2.98, 4.2] : [1, 2.76, 5.4, 8.93];
+  const now = ctx.currentTime;
+
+  const master = ctx.createGain();
+  master.gain.value = 0.9;
+  master.connect(ctx.destination);
+
+  partials.forEach((ratio, index) => {
+    const osc = ctx.createOscillator();
+    const gain = ctx.createGain();
+    osc.type = 'sine';
+    osc.frequency.value = base * ratio;
+    const partialPeak = peak / (index + 1.6);
+    const decay = duration * (1 - index * 0.16);
+    gain.gain.setValueAtTime(0, now);
+    // A 6 ms attack avoids the click a hard start produces.
+    gain.gain.linearRampToValueAtTime(partialPeak, now + 0.006);
+    gain.gain.exponentialRampToValueAtTime(0.0001, now + decay);
+    osc.connect(gain).connect(master);
+    osc.start(now);
+    osc.stop(now + decay + 0.05);
+  });
+
+  // Release the graph once the tail has finished.
+  setTimeout(() => {
+    try {
+      master.disconnect();
+    } catch {
+      /* nothing to release */
+    }
+  }, (duration + 0.4) * 1000);
+  return true;
+}
+
+/**
+ * Browsers refuse to start audio outside a user gesture. Call this from the
+ * click that enables sound (or starts the timer) so the context is unlocked
+ * before anything tries to play.
+ */
+export function unlock() {
+  const ctx = ensureContext();
+  if (!ctx) return false;
+  if (ctx.state === 'suspended') ctx.resume().catch(() => {});
+  return true;
+}
+
+/** Release everything — used when the workspace is left or the tab is hidden. */
+export function suspend() {
+  stopAmbient();
+  if (context && context.state === 'running') context.suspend().catch(() => {});
+}
