+/* --------------------------------------------------------------------------
+   5. Motion — all of it behind prefers-reduced-motion: no-preference
+   -------------------------------------------------------------------------- */
+
+@media (prefers-reduced-motion: no-preference) {
+  .focus-workspace,
+  .focus-stage .card-body {
+    transition: background var(--dur-base) var(--ease-out);
+  }
+
+  .focus-progress > span,
+  .week-fill {
+    transition: width var(--dur-base) linear, height var(--dur-base) var(--ease-out);
+  }
+
+  .flip-colon {
+    animation: flipColonPulse 2s ease-in-out infinite;
+  }
+
+  @keyframes flipColonPulse {
+    0%, 100% { opacity: 0.9; }
+    50% { opacity: 0.4; }
+  }
+
+  /* 300 ms per flap, staged: the top falls, then the bottom rises. */
+  .flip-flap.top {
+    animation: flipTop 300ms cubic-bezier(0.37, 0, 0.63, 1) forwards;
+  }
+
+  .flip-flap.bottom {
+    transform: rotateX(90deg);
+    animation: flipBottom 300ms cubic-bezier(0.37, 0, 0.63, 1) 300ms forwards;
+  }
+
+  @keyframes flipTop {
+    0% { transform: rotateX(0deg); filter: brightness(1); }
+    100% { transform: rotateX(-90deg); filter: brightness(0.6); }
+  }
+
+  @keyframes flipBottom {
+    0% { transform: rotateX(90deg); filter: brightness(0.6); }
+    100% { transform: rotateX(0deg); filter: brightness(1); }
+  }
+
+  .rain-drop {
+    animation: focusRainfall var(--dur, 2.4s) linear infinite;
+    animation-delay: var(--delay, 0s);
+  }
+
+  @keyframes focusRainfall {
+    from { transform: translate3d(0, -30vh, 0) rotate(11deg); }
+    to { transform: translate3d(-70px, 130vh, 0) rotate(11deg); }
+  }
+
+  .mist-band {
+    animation: focusMistDrift 36s ease-in-out infinite alternate;
+  }
+
+  .mist-band.b {
+    animation-duration: 52s;
+    animation-delay: -18s;
+    animation-direction: alternate-reverse;
+  }
+
+  @keyframes focusMistDrift {
+    from { transform: translate3d(-3%, 0, 0); }
+    to { transform: translate3d(3%, 0, 0); }
+  }
+
+  .particle-leaf {
+    animation: focusLeafFall var(--dur, 20s) linear infinite;
+    animation-delay: var(--delay, 0s);
+  }
+
+  @keyframes focusLeafFall {
+    0% { transform: translate3d(var(--sx, 0), -8vh, 0) rotate(0deg); }
+    45% { transform: translate3d(calc(var(--sx, 0) + var(--sway, 10px)), 45vh, 0) rotate(calc(var(--rot, 360deg) * 0.55)); }
+    100% { transform: translate3d(calc(var(--sx, 0) + var(--ex, 0)), 108vh, 0) rotate(var(--rot, 360deg)); }
+  }
+
+  .star-dot {
+    animation: focusTwinkle var(--tw-dur, 4s) ease-in-out infinite;
+    animation-delay: var(--tw-delay, 0s);
+  }
+
+  @keyframes focusTwinkle {
+    0%, 100% { opacity: calc(var(--tw-op, 0.3) * 0.45); }
+    50% { opacity: var(--tw-op, 0.3); }
+  }
+
+  .shooting-star {
+    animation: focusShootingStar var(--star-duration, 1.2s) ease-out forwards;
+  }
+
+  @keyframes focusShootingStar {
+    0% { transform: translate3d(0, 0, 0) rotate(var(--star-angle, 20deg)); opacity: 0; }
+    10% { opacity: var(--star-opacity, 0.3); }
+    70% { opacity: var(--star-opacity, 0.3); }
+    100% {
+      transform: translate3d(var(--star-travel-x, 600px), var(--star-travel-y, 300px), 0) rotate(var(--star-angle, 20deg));
+      opacity: 0;
+    }
+  }
+
+  .setting-switch,
+  .seg button,
+  .session-row {
+    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  /* The global reduce block already removes animation and transition; these
+     rules only make sure nothing is left waiting on a keyframe that will never
+     run (the flap halves must sit at their final angle, not mid-flip). */
+  .flip-flap.top,
+  .flip-flap.bottom {
+    display: none;
+  }
+
+  .flip-colon,
+  .rain-drop,
+  .particle-leaf,
+  .shooting-star,
+  .mist-band,
+  .star-dot {
+    animation: none;
+  }
