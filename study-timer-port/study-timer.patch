+}
+
+/* --------------------------------------------------------------------------
+   7. Consistency heatmap (Study hours)
+
+   Seven rows by twenty-six columns, filled column by column: the grid flows
+   `grid-auto-flow: column` with seven rows, so each column is one week and the
+   reading order is Sunday → Saturday down the page. Intensity is a class, not a
+   width, which keeps the palette in this stylesheet.
+   -------------------------------------------------------------------------- */
+
+.hm-wrap {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.hm-grid {
+  display: grid;
+  grid-auto-flow: column;
+  grid-template-rows: repeat(7, 1fr);
+  gap: 3px;
+  width: 100%;
+  overflow-x: auto;
+}
+
+.hm-cell {
+  display: block;
+  aspect-ratio: 1 / 1;
+  min-width: 8px;
+  border-radius: 2px;
+  background: var(--track);
+}
+
+.hm-l0 { background: var(--bg-sunken); outline: 1px solid var(--border-subtle); outline-offset: -1px; }
+.hm-l1 { background: var(--accent-soft); }
+.hm-l2 { background: var(--accent); opacity: 0.55; }
+.hm-l3 { background: var(--accent); opacity: 0.78; }
+.hm-l4 { background: var(--accent); }
+.hm-cell.is-future { opacity: 0.35; }
+
+.hm-legend {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+  font-size: var(--text-2xs);
+}
+
+.hm-scale {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+}
+
+.hm-scale .hm-cell {
+  width: 11px;
+  min-width: 11px;
+}
+
+@media (max-width: 860px) {
+  /* Twenty-six weeks cannot be legible on a phone at full width; let it scroll
+     rather than shrink the squares to hairlines. */
+  .hm-grid {
+    min-width: 520px;
+  }
+}
